# PromiseLedger Environment Configuration
# Copy this file to .env.local to configure local settings.

# Frontend API Configuration:
# Set to your FastAPI backend URL (e.g. http://localhost:8000) for end-to-end live mode.
# If omitted or empty, the frontend operates in standalone Mock Demo mode.
VITE_API_BASE_URL=http://localhost:8000

# Backend Server Environment Variables (Python server only - never exposed to React):
# PORT=8000
# EXTRACTOR_FORCE_FALLBACK=0
# OPEN_WEIGHT_API_KEY=your_huggingface_or_groq_key_here
# GROQ_API_KEY=your_groq_key_here

