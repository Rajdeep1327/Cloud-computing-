# PromiseLedger environment variables
# Copy this file to .env.local and fill in values for live mode.
# Leave empty (or omit .env.local entirely) to use mock/demo mode.

# Claim Extractor service
# VITE_EXTRACTOR_ENDPOINT=https://your-backend.example.com/api/extract
# VITE_EXTRACTOR_API_KEY=your-extractor-key-here

# Claim Verifier service
# VITE_VERIFIER_ENDPOINT=https://your-backend.example.com/api/verify
# VITE_VERIFIER_API_KEY=your-verifier-key-here
